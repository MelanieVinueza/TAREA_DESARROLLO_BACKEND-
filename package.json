{
  "name": "backend-productos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de productos con Express y PostgreSQL",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "check:modules": "madge --circular src",
    "db:check": "node scripts/database.js check",
    "db:schema": "node scripts/database.js schema",
    "db:seed": "node scripts/database.js seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "madge": "^8.0.0",
    "nodemon": "^3.1.10"
  }
}
